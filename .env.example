# RenderLedger configuration. Blank values disable credentials. Never commit .env.
# These settings are read from .env or the process environment.
RUNPOD_API_KEY_DEV_READONLY=
RUNPOD_API_KEY=
ELEVENLABS_DEV_KEY=
ELEVENLABS_API_KEY=
NPU_LAB_ELEVENLABS_ALLOW_SUBSCRIPTION=0
NPU_LAB_ELEVENLABS_MUSIC_CREDIT_CEILING=
NPU_LAB_MUSIC_MODEL=
NPU_LAB_VIDEO_MODEL=

# Optional process environment overrides. Set these in PowerShell before launching,
# e.g. $env:NPU_LAB_DB = 'C:\path\renderledger.sqlite3'.
# NPU_LAB_DB=
# NPU_LAB_GENAI_PYTHON=
# NPU_LAB_PYTHON=
# NPU_LAB_RUNNER=
